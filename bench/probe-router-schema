#!/usr/bin/env bash
# Send the intake router's own schema the way the runtime sends it — as one
# forced function call — and report how many characters come back. A router
# that answers empty is either being asked for a shape the model will not
# produce, or is not the schema's fault at all, and there is no way to tell
# from inside a scenario run.
set -euo pipefail

# shellcheck source=bench/environment-file
source "$(dirname "$0")/environment-file"
loadEnvironmentFile

model="${BENCH_MODEL:-openai/gpt-5.6-luna}"
schemaFile="${1:-/tmp/router-schema.json}"
requestFile="$(mktemp)"
responseFile="$(mktemp)"
trap 'rm -f "$requestFile" "$responseFile"' EXIT

PROBE_MODEL="$model" python3 - "$schemaFile" "$requestFile" <<'PYTHON'
import json, os, sys

schema = json.load(open(sys.argv[1]))
request = {
    "model": os.environ["PROBE_MODEL"],
    "usage": {"include": True},
    "messages": [{"role": "user", "content": os.environ.get("PROBE_PREFIX", "") + "회의록에서 결정사항, 담당자, 기한을 정리해줘."}],
}
if os.environ.get("PROBE_RESPONSE_FORMAT"):
    request["response_format"] = {
        "type": "json_schema",
        "json_schema": {"name": "bluecollar_turn_router", "strict": True, "schema": schema},
    }
else:
    request["tools"] = [{"type": "function", "function": {"name": "bluecollar_turn_router", "parameters": schema}}]
    request["tool_choice"] = {"type": "function", "function": {"name": "bluecollar_turn_router"}}
open(sys.argv[2], "w").write(json.dumps(request))
PYTHON

curl -sS https://openrouter.ai/api/v1/chat/completions \
  -H "Authorization: Bearer $OPENROUTER_API_KEY" \
  -H "Content-Type: application/json" \
  -d @"$requestFile" > "$responseFile"

python3 - "$responseFile" <<'PYTHON'
import json, sys

document = json.load(open(sys.argv[1]))
if "error" in document:
    print("endpoint refused:", json.dumps(document["error"])[:400])
    raise SystemExit
message = (document.get("choices") or [{}])[0].get("message") or {}
calls = message.get("tool_calls") or []
if not calls:
    content = message.get("content") or ""
    print(f"no tool call; content {len(content)} characters")
    print(content[:300])
    raise SystemExit
arguments = calls[0]["function"]["arguments"]
print(f"tool call returned {len(arguments)} characters")
print(arguments[:300])
PYTHON
